TZ=__TZ__

# Jellyfin runs as this user. It needs read access to MEDIA_DIR.
PUID=__PUID__
PGID=__PGID__

# Folder with your media on the server, e.g. with the subfolders Movies and Shows
MEDIA_DIR=/srv/media

# Only for hardware transcoding: ID of the host's render group
# getent group render | cut -d: -f3
RENDER_GID=
