# Random values, e.g. from: openssl rand -hex 32
# The secret key must never change after the first start.
AUTHENTIK_SECRET_KEY=__SECRET__
PG_PASS=__SECRET__

# Optional: e-mail for alerts and password resets
# AUTHENTIK_EMAIL__HOST=smtp.example.com
# AUTHENTIK_EMAIL__PORT=587
# AUTHENTIK_EMAIL__USERNAME=
# AUTHENTIK_EMAIL__PASSWORD=
# AUTHENTIK_EMAIL__USE_TLS=true
# AUTHENTIK_EMAIL__FROM=authentik@__DOMAIN__
