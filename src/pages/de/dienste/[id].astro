---
import ServicePage from '../../../views/ServicePage.astro';
import { getServices } from '../../../lib/content';

export async function getStaticPaths() {
  return (await getServices('de')).map((service) => ({ params: { id: service.id }, props: { service } }));
}
const { service } = Astro.props;
---

<ServicePage lang="de" service={service} />
