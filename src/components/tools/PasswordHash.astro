---
/** bcrypt hash generator for Tinyauth, Traefik basicauth and htpasswd. Everything runs in the browser. */
import type { Lang } from '../../lib/i18n';
import { t } from '../../lib/i18n';
import { url } from '../../lib/routes';
import { COST_DEFAULT, COST_MAX, COST_MIN } from '../../lib/tools/password-hash';
import SecretGenerator from './SecretGenerator.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const k = (key: string, vars?: Record<string, string | number>) => t(lang, `tools.password-hash.${key}`, vars);
const msgs = {
  show: k('show'),
  hide: k('hide'),
  working: k('working'),
  generate: k('generate'),
  errUser: k('errUser'),
  errPassword: k('errPassword'),
  errName: k('errName'),
  tooLong: k('tooLong'),
  stale: k('stale'),
  failed: k('failed'),
};
const copy = t(lang, 'code.copy');
---

<SecretGenerator lang={lang} />

<div class="ph" data-ph-tool>
  <script type="application/json" data-ph-msgs set:html={JSON.stringify(msgs)} />
  <div class="ph-head">
    <h2>{k('hashTitle')}</h2>
    <p class="muted">{k('hashLead')}</p>
  </div>

  <p class="local card">
    <span class="tag">{k('localTag')}</span>
    <span>{k('local')}</span>
  </p>

  <form class="card form" novalidate data-ph-form>
    <div class="grid2">
      <label>
        {k('user')}
        <input name="user" value="admin" autocomplete="off" autocapitalize="off" spellcheck="false" required aria-describedby="ph-user-err" />
        <span class="err" id="ph-user-err" data-err="user" hidden></span>
      </label>
      <label>
        {k('cost')}
        <input name="cost" type="number" min={COST_MIN} max={COST_MAX} step="1" value={COST_DEFAULT} inputmode="numeric" aria-describedby="ph-cost-hint" />
        <span class="hint" id="ph-cost-hint">{k('costHint')}</span>
      </label>
    </div>

    <label for="ph-pw" class="pw-label">{k('password')}</label>
    <div class="pw-row">
      <input id="ph-pw" name="password" type="password" autocomplete="new-password" autocapitalize="off" spellcheck="false" aria-describedby="ph-pw-err" />
      <button type="button" class="btn btn-outline btn-sm" data-toggle aria-pressed="false" aria-controls="ph-pw">{k('show')}</button>
      <button type="button" class="btn btn-soft btn-sm" data-random>{k('random')}</button>
    </div>
    <span class="err" id="ph-pw-err" data-err="password" hidden></span>
    <span class="warn" data-warn hidden></span>

    <label class="narrow">
      {k('name')}
      <input name="name" value="myapp" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="ph-name-hint ph-name-err" />
      <span class="hint" id="ph-name-hint">{k('nameHint')}</span>
      <span class="err" id="ph-name-err" data-err="name" hidden></span>
    </label>

    <div class="actions">
      <button type="submit" class="btn btn-primary" data-go>{k('generate')}</button>
      <span class="status" role="status" aria-live="polite" data-status></span>
    </div>
  </form>

  <section class="out" data-out hidden aria-label={k('outputs')}>
    <div class="block card">
      <h2>{k('tinyauthTitle')}</h2>
      <p>{k('tinyauthText')}</p>
      <div class="code"><pre data-o="tinyauth"></pre><button type="button" class="copy-btn" data-copy>{copy}</button></div>
      <p class="muted small">{k('tinyauthMore')}</p>
    </div>

    <div class="block card">
      <h2>{k('traefikTitle')}</h2>
      <p>{k('traefikText')}</p>
      <div class="code"><pre data-o="traefik"></pre><button type="button" class="copy-btn" data-copy>{copy}</button></div>
      <p class="muted small">{k('traefikMore')}</p>
    </div>

    <div class="block card">
      <h2>{k('htpasswdTitle')}</h2>
      <p>{k('htpasswdText')}</p>
      <div class="code"><pre data-o="htpasswd"></pre><button type="button" class="copy-btn" data-copy>{copy}</button></div>
    </div>
  </section>

  <p class="more muted">
    {k('formatNote')}
    <a href={url.guide(lang, 'tinyauth')}>{k('guideLink')}</a>
  </p>
</div>

<script>
  import { hash, outputs, randomPassword, tooLong, validName, validUser, clampCost } from '../../lib/tools/password-hash';
  import { renderCode } from '../../lib/highlight';

  const root = document.querySelector<HTMLElement>('[data-ph-tool]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const msgs: Record<string, string> = JSON.parse(root.querySelector('[data-ph-msgs]')!.textContent!);
    const form = root.querySelector<HTMLFormElement>('[data-ph-form]')!;
    const f = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const user = f('user'), pw = f('password'), cost = f('cost'), name = f('name');
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const go = root.querySelector<HTMLButtonElement>('[data-go]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const warn = root.querySelector<HTMLElement>('[data-warn]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    let current: string | null = null; // last hash
    let busy = false;
    let job = 0;

    const setErr = (key: string, msg: string | null, input: HTMLInputElement) => {
      const el = root.querySelector<HTMLElement>(`[data-err="${key}"]`)!;
      el.hidden = !msg;
      el.textContent = msg ?? '';
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      return !msg;
    };

    const checkUser = () => setErr('user', validUser(user.value.trim()) ? null : msgs.errUser, user);
    const checkName = () => setErr('name', validName(name.value.trim()) ? null : msgs.errName, name);
    const checkPw = () => setErr('password', pw.value ? null : msgs.errPassword, pw);

    function render() {
      if (!current) return;
      const o = outputs(user.value.trim(), current, name.value.trim());
      for (const [key, text] of Object.entries(o)) {
        root.querySelector(`[data-o="${key}"]`)!.innerHTML = renderCode(text, { values: {} });
      }
    }

    function invalidate() {
      job++;
      if (!current) return;
      current = null;
      out.hidden = true;
      status.textContent = msgs.stale;
    }

    function setVisible(v: boolean) {
      pw.type = v ? 'text' : 'password';
      toggle.textContent = v ? msgs.hide : msgs.show;
      toggle.setAttribute('aria-pressed', String(v));
    }

    toggle.addEventListener('click', () => setVisible(pw.type === 'password'));
    root.querySelector('[data-random]')!.addEventListener('click', () => {
      pw.value = randomPassword();
      setVisible(true);
      pw.dispatchEvent(new Event('input'));
    });

    pw.addEventListener('input', () => {
      warn.hidden = !tooLong(pw.value);
      warn.textContent = msgs.tooLong;
      if (pw.value) checkPw();
      invalidate();
    });
    cost.addEventListener('input', invalidate);
    user.addEventListener('input', () => checkUser() && render());
    name.addEventListener('input', () => checkName() && render());

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return;
      const ok = [checkUser(), checkPw(), checkName()].every(Boolean);
      if (!ok) {
        form.querySelector<HTMLInputElement>('[aria-invalid="true"]')?.focus();
        return;
      }
      const c = clampCost(Number(cost.value));
      cost.value = String(c);
      busy = true;
      go.disabled = true;
      go.textContent = msgs.working;
      status.textContent = '';
      const my = ++job;
      try {
        const h = await hash(pw.value, c);
        if (my !== job) return; // input changed meanwhile
        current = h;
        render();
        out.hidden = false;
      } catch {
        status.textContent = msgs.failed;
      } finally {
        busy = false;
        go.disabled = false;
        go.textContent = msgs.generate;
      }
    });
  }
</script>

<style>
  .ph-head { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; }
  .ph-head h2 { font-size: 22px; font-weight: 700; letter-spacing: -0.01em; }
  .ph { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .local { border-radius: 16px; padding: 14px 18px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; font-size: 14.5px; color: var(--text-2); }
  .form { border-radius: 20px; padding: 22px 24px; display: flex; flex-direction: column; gap: 16px; }
  label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600; color: var(--text-4); min-width: 0; }
  .pw-label { margin-bottom: -10px; }
  input {
    height: 42px; border: 1.5px solid var(--line-2); border-radius: 12px; padding: 0 14px; font-family: var(--mono); font-size: 13.5px;
    color: var(--accent-600); background: #f7fafc; min-width: 0; width: 100%;
  }
  input:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px var(--ring, rgba(0, 150, 200, 0.2)); }
  input[aria-invalid='true'] { border-color: var(--warn-fg); }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .narrow { max-width: 340px; }
  .pw-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .pw-row input { flex: 1 1 220px; }
  .hint { font-size: 12.5px; font-weight: 400; color: var(--muted); }
  .err, .warn { font-size: 13px; font-weight: 500; color: var(--warn-fg); }
  .warn { background: var(--warn-bg); border-radius: 10px; padding: 8px 12px; }
  .actions { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .status { font-size: 13.5px; color: var(--muted); }
  .out { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .out[hidden] { display: none; }
  .block { border-radius: 20px; padding: 20px 24px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .block h2 { font-size: 17px; font-weight: 700; }
  .block p { font-size: 14.5px; line-height: 1.55; color: var(--text-2); }
  .block p.small { font-size: 13.5px; color: var(--muted); }
  .more { font-size: 14px; line-height: 1.55; }
  @media (max-width: 600px) {
    .form, .block { padding: 18px 16px; }
  }
</style>
