---
/**
 * Power calculator: yearly kWh and cost of always-on hardware, with presets and a comparison table.
 * Calculation lives in src/lib/tools/power.ts. Inputs are remembered in localStorage (per viewer).
 */
import { getWiki } from '../../lib/content';
import { t, type Lang } from '../../lib/i18n';
import { url } from '../../lib/routes';
import { currencies, powerPresets } from '../../lib/tools/power';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const k = (key: string, vars?: Record<string, string | number>) => t(lang, `tools.power-calculator.${key}`, vars);

const wiki = (await getWiki(lang)).items;
const costSlug = wiki.find((w) => w.id === 'costs-power')?.slug ?? 'costs-power';
const hwSlug = wiki.find((w) => w.id === 'hardware-overview')?.slug ?? 'hardware-overview';

const presets = powerPresets.map((p) => ({ ...p, label: k(`preset.${p.id}`) }));
const data = {
  lang,
  presets,
  text: {
    perWatt: k('perWatt'),
    avg: k('avg'),
    current: k('current'),
  },
};
const defaultCurrency = '€';
---

<div class="pc" data-power>
  <script type="application/json" data-power-data set:html={JSON.stringify(data)} />

  <section class="card panel" aria-labelledby="pc-in">
    <h2 id="pc-in" class="h3">{k('device')}</h2>
    <div>
      <span class="lbl" id="pc-presets-l">{k('presets')}</span>
      <div class="presets" role="group" aria-labelledby="pc-presets-l">
        {
          presets.map((p) => (
            <button type="button" class="pchip" data-preset={p.id} aria-pressed="false">
              {p.label} <b>~{p.watts} W</b>
            </button>
          ))
        }
      </div>
    </div>
    <div class="grid">
      <label>{k('idle')}<span class="unit"><input name="idle" type="number" inputmode="decimal" min="0" step="0.5" value="8" /><i>W</i></span></label>
      <label>{k('devices')}<input name="devices" type="number" inputmode="numeric" min="1" step="1" value="1" /></label>
    </div>
    <details class="more" data-load-box>
      <summary>{k('loadToggle')}</summary>
      <div class="grid">
        <label>{k('load')}<span class="unit"><input name="load" type="number" inputmode="decimal" min="0" step="1" placeholder="–" /><i>W</i></span></label>
        <label>{k('loadShare')}<span class="unit"><input name="loadShare" type="number" inputmode="decimal" min="0" max="100" step="1" value="10" /><i>%</i></span></label>
      </div>
      <p class="muted small">{k('loadHint')}</p>
    </details>
  </section>

  <section class="card panel" aria-labelledby="pc-run">
    <h2 id="pc-run" class="h3">{k('priceRuntime')}</h2>
    <div class="grid">
      <label>
        {k('price')}
        <span class="unit"><input name="price" type="number" inputmode="decimal" min="0" step="0.01" value="0.35" /><i data-cur-sym>{defaultCurrency}</i></span>
      </label>
      <div class="field">
        <span class="lbl" id="pc-cur-l">{k('currency')}</span>
        <div class="row" role="radiogroup" aria-labelledby="pc-cur-l">
          {
            Object.keys(currencies).map((c) => (
              <label class="opt">
                <input type="radio" name="currency" value={c} checked={c === defaultCurrency} />
                <span>{c}</span>
              </label>
            ))
          }
        </div>
      </div>
    </div>
    <p class="assume small">{k('priceAssumption')}</p>
    <div class="field">
      <span class="lbl" id="pc-rt-l">{k('runtime')}</span>
      <div class="row" role="radiogroup" aria-labelledby="pc-rt-l">
        <label class="opt"><input type="radio" name="mode" value="always" checked /><span>{k('always')}</span></label>
        <label class="opt"><input type="radio" name="mode" value="hours" /><span>{k('hoursMode')}</span></label>
      </div>
      <label class="narrow" data-hours-box hidden>{k('hours')}<span class="unit"><input name="hours" type="number" inputmode="decimal" min="0" max="24" step="0.5" value="12" /><i>h</i></span></label>
    </div>
  </section>

  <section class="card panel result" aria-labelledby="pc-res" aria-live="polite">
    <h2 id="pc-res" class="eyebrow">{k('result')}</h2>
    <div class="stats">
      <div class="stat"><span class="s-l">{k('kwhYear')}</span><span class="s-v" data-out="kwh">–</span></div>
      <div class="stat"><span class="s-l">{k('perMonth')}</span><span class="s-v" data-out="month">–</span></div>
      <div class="stat main"><span class="s-l">{k('perYear')}</span><span class="s-v" data-out="year">–</span></div>
    </div>
    <p class="small muted" data-out="avg"></p>
    <p class="rule" data-out="perWatt"></p>
  </section>

  <section class="card panel" aria-labelledby="pc-cmp">
    <h2 id="pc-cmp" class="h3">{k('compare')}</h2>
    <p class="muted small">{k('compareHint')}</p>
    <div class="tbl-wrap">
      <table>
        <thead>
          <tr><th scope="col">{k('colDevice')}</th><th scope="col" class="num">{k('colWatts')}</th><th scope="col" class="num">{k('colKwh')}</th><th scope="col" class="num">{k('colCost')}</th></tr>
        </thead>
        <tbody data-table></tbody>
      </table>
    </div>
  </section>

  <p class="links">
    <a href={url.wiki(lang, costSlug)}>{k('linkWiki')} →</a>
    <a href={url.wiki(lang, hwSlug)}>{k('linkHw')} →</a>
  </p>
</div>

<script>
  import { calcPower, currencies, type CurrencySymbol } from '../../lib/tools/power';

  interface Data {
    lang: 'de' | 'en';
    presets: { id: string; watts: number; label: string }[];
    text: Record<string, string>;
  }
  const KEY = 'yhl-power';
  const FIELDS = ['idle', 'devices', 'load', 'loadShare', 'price', 'hours'] as const;

  for (const root of document.querySelectorAll<HTMLElement>('[data-power]')) {
    const data: Data = JSON.parse(root.querySelector('[data-power-data]')!.textContent!);
    const T = data.text;
    const loc = data.lang === 'de' ? 'de-DE' : 'en-US';
    const n0 = new Intl.NumberFormat(loc, { maximumFractionDigits: 0 });
    const n1 = new Intl.NumberFormat(loc, { maximumFractionDigits: 1 });
    const fill = (s: string, v: Record<string, string>) => s.replace(/\{(\w+)\}/g, (_, x) => v[x] ?? '');
    const input = (name: string) => root.querySelector<HTMLInputElement>(`input[name="${name}"]`)!;
    const radio = (name: string) => root.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? '';
    const val = (name: string) => parseFloat(input(name).value.replace(',', '.'));
    const loadBox = root.querySelector<HTMLDetailsElement>('[data-load-box]')!;
    const hoursBox = root.querySelector<HTMLElement>('[data-hours-box]')!;
    const out = (id: string) => root.querySelector<HTMLElement>(`[data-out="${id}"]`)!;

    // Restore saved values
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) ?? 'null');
      if (saved && typeof saved === 'object') {
        for (const f of FIELDS) if (typeof saved[f] === 'string') input(f).value = saved[f];
        for (const r of ['currency', 'mode'])
          if (typeof saved[r] === 'string') root.querySelectorAll<HTMLInputElement>(`input[name="${r}"]`).forEach((i) => (i.checked = i.value === saved[r]));
        if (saved.load) loadBox.open = true;
      }
    } catch {}

    function save() {
      try {
        const s: Record<string, string> = { currency: radio('currency'), mode: radio('mode') };
        for (const f of FIELDS) s[f] = input(f).value;
        localStorage.setItem(KEY, JSON.stringify(s));
      } catch {}
    }

    function render() {
      const sym = (radio('currency') || '€') as CurrencySymbol;
      const money = new Intl.NumberFormat(loc, { style: 'currency', currency: currencies[sym] ?? 'EUR', maximumFractionDigits: 2 });
      root.querySelector('[data-cur-sym]')!.textContent = sym;
      const always = radio('mode') !== 'hours';
      hoursBox.hidden = always;
      const hours = always ? 24 : val('hours') || 0;
      const price = val('price') || 0;
      const idle = val('idle') || 0;
      const r = calcPower({ idle, load: val('load') || 0, loadShare: val('loadShare') || 0, price, devices: val('devices') || 1, hours });

      out('kwh').textContent = `${n0.format(r.kwhYear)} kWh`;
      out('month').textContent = money.format(r.costMonth);
      out('year').textContent = money.format(r.costYear);
      out('avg').textContent = fill(T.avg, { w: n1.format(r.avgWatts) });
      out('perWatt').textContent = fill(T.perWatt, { cost: money.format(r.costPerWatt) });

      root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => {
        const p = data.presets.find((x) => x.id === b.dataset.preset)!;
        b.setAttribute('aria-pressed', String(p.watts === idle));
      });

      const tbody = root.querySelector('[data-table]')!;
      tbody.replaceChildren();
      const rows = data.presets.map((p) => ({ label: p.label, watts: p.watts, current: false }));
      if (!data.presets.some((p) => p.watts === r.avgWatts)) rows.push({ label: T.current, watts: r.avgWatts, current: true });
      rows.sort((a, b) => a.watts - b.watts);
      for (const row of rows) {
        const c = calcPower({ idle: row.watts, loadShare: 0, price, devices: 1, hours });
        const tr = document.createElement('tr');
        if (row.current || (!rows.some((x) => x.current) && row.watts === r.avgWatts)) tr.className = 'cur';
        const th = document.createElement('th');
        th.scope = 'row';
        th.textContent = row.label;
        tr.append(th);
        for (const txt of [`${n1.format(row.watts)} W`, n0.format(c.kwhYear), money.format(c.costYear)]) {
          const td = document.createElement('td');
          td.className = 'num';
          td.textContent = txt;
          tr.append(td);
        }
        tbody.append(tr);
      }
    }

    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
      b.addEventListener('click', () => {
        const p = data.presets.find((x) => x.id === b.dataset.preset)!;
        input('idle').value = String(p.watts);
        save();
        render();
      }),
    );
    root.addEventListener('input', () => {
      save();
      render();
    });
    root.addEventListener('change', () => {
      save();
      render();
    });
    render();
  }
</script>

<style>
  .pc { display: flex; flex-direction: column; gap: 20px; }
  .panel { border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .h3 { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; }
  .small { font-size: 13.5px; }
  .lbl { display: block; font-size: 13px; font-weight: 600; color: var(--text-4); margin-bottom: 8px; }
  .presets { display: flex; flex-wrap: wrap; gap: 8px; }
  .pchip {
    border: 1.5px solid var(--line-2); background: var(--surface); color: var(--text-2); border-radius: 999px; padding: 7px 13px;
    font-size: 13.5px; cursor: pointer; font-family: inherit;
  }
  .pchip b { font-family: var(--mono); font-weight: 400; color: var(--accent-600); margin-left: 4px; }
  .pchip:hover { border-color: var(--accent); }
  .pchip[aria-pressed='true'] { border-color: var(--accent); background: var(--accent-50); color: var(--accent-600); font-weight: 600; }
  .pchip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px 16px; }
  label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600; color: var(--text-4); min-width: 0; }
  label[hidden] { display: none; }
  .narrow { max-width: 220px; margin-top: 10px; }
  .field { display: flex; flex-direction: column; min-width: 0; }
  input:not([type='radio']) {
    height: 42px; border: 1.5px solid var(--line-2); border-radius: 12px; padding: 0 14px; font-family: var(--mono); font-size: 14px;
    color: var(--accent-600); background: #f7fafc; min-width: 0; width: 100%;
  }
  input:not([type='radio']):focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px var(--ring); }
  .unit { position: relative; display: block; }
  .unit input { padding-right: 38px; }
  .unit i { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-style: normal; font-family: var(--mono); font-size: 13px; color: var(--muted); pointer-events: none; }
  .row { display: flex; gap: 8px; flex-wrap: wrap; }
  .opt { position: relative; flex-direction: row; }
  .opt input { position: absolute; opacity: 0; pointer-events: none; }
  .opt span {
    border: 1.5px solid var(--line-2); background: var(--surface); color: var(--text-2); border-radius: 999px; padding: 7px 14px;
    font-size: 13.5px; font-weight: 400; cursor: pointer;
  }
  .opt input:checked + span { border-color: var(--accent); background: var(--accent-50); color: var(--accent-600); font-weight: 600; }
  .opt input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .more summary { cursor: pointer; font-size: 14.5px; font-weight: 600; color: var(--accent-600); }
  .more[open] summary { margin-bottom: 12px; }
  .more .small { margin-top: 8px; }
  .assume { padding: 10px 14px; border-radius: 12px; background: var(--warn-bg); color: var(--warn-fg); line-height: 1.5; }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .stat { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border-radius: 14px; background: var(--bg); min-width: 0; }
  .stat.main { background: var(--accent-50); color: var(--accent-600); }
  .s-l { font-size: 13px; font-weight: 600; color: var(--text-4); }
  .stat.main .s-l { color: inherit; }
  .s-v { font-size: 26px; font-weight: 700; letter-spacing: -0.02em; overflow-wrap: anywhere; }
  .rule { font-size: 15px; font-weight: 600; }

  .tbl-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  table :global(th), table :global(td) { text-align: left; padding: 9px 10px; border-bottom: 1px solid var(--line-2); }
  thead th { font-size: 12.5px; color: var(--text-4); font-weight: 600; }
  tbody :global(th) { font-weight: 500; }
  table :global(.num) { text-align: right; font-family: var(--mono); font-size: 13px; white-space: nowrap; }
  tbody :global(tr.cur) { background: var(--accent-50); }
  tbody :global(tr.cur th) { font-weight: 700; color: var(--accent-600); }
  .links { display: flex; gap: 8px 22px; flex-wrap: wrap; font-size: 14.5px; }
  @media (max-width: 480px) {
    .panel { padding: 16px; }
    table :global(th), table :global(td) { padding: 8px 6px; }
    .s-v { font-size: 22px; }
  }
</style>
