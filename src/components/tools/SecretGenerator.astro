---
/** Random secrets (tokens, keys, passwords) of any length. Part of the password-hash tool; runs in the browser. */
import { t, type Lang } from '../../lib/i18n';
import { charsets, LENGTH_DEFAULT, LENGTH_MAX, LENGTH_MIN, type Charset } from '../../lib/tools/secret';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const k = (key: string, vars?: Record<string, string | number>) => t(lang, `tools.secret.${key}`, vars);
const sets = Object.keys(charsets) as Charset[];
const msgs = { bits: k('bits'), copy: t(lang, 'code.copy'), copied: t(lang, 'code.copied') };
---

<section class="card sg" data-sg aria-labelledby="sg-title">
  <script type="application/json" data-sg-msgs set:html={JSON.stringify(msgs)} />
  <div class="sg-head">
    <h2 id="sg-title">{k('title')}</h2>
    <p class="muted">{k('lead')}</p>
  </div>

  <div class="sg-form">
    <label class="len">
      {k('length')}
      <span class="len-row">
        <input type="range" min={LENGTH_MIN} max={128} value={LENGTH_DEFAULT} data-sg-range aria-hidden="true" tabindex="-1" />
        <input type="number" name="length" min={LENGTH_MIN} max={LENGTH_MAX} value={LENGTH_DEFAULT} inputmode="numeric" data-sg-length />
      </span>
    </label>
    <div class="presets" role="group" aria-label={k('presets')}>
      {[16, 24, 32, 48, 64].map((n) => <button type="button" class="chip-btn" data-sg-preset={n}>{n}</button>)}
    </div>
    <fieldset class="sets">
      <legend>{k('charset')}</legend>
      {
        sets.map((s) => (
          <label class="set">
            <input type="radio" name="charset" value={s} checked={s === 'hex'} />
            <span>
              <b>{k(`set.${s}`)}</b>
              <small>{k(`setHint.${s}`)}</small>
            </span>
          </label>
        ))
      }
    </fieldset>
    <label class="count">
      {k('count')}
      <input type="number" name="count" min="1" max="10" value="1" inputmode="numeric" data-sg-count />
    </label>
  </div>

  <div class="sg-out">
    <div class="sg-bar">
      <span class="muted small" data-sg-bits></span>
      <button type="button" class="btn btn-primary btn-sm" data-sg-new>{k('regenerate')}</button>
    </div>
    <ul class="list" data-sg-list aria-live="polite"></ul>
    <p class="muted small">{k('shell')}</p>
    <div class="code"><pre data-sg-cmd></pre><button type="button" class="copy-btn" data-copy>{t(lang, 'code.copy')}</button></div>
    <p class="muted small">{k('where')}</p>
  </div>
</section>

<script>
  import { copyText } from '../../client/store';
  import { charsets, clampLength, entropyBits, randomString, shellCommand, type Charset } from '../../lib/tools/secret';

  const KEY = 'yhl-secret';
  for (const root of document.querySelectorAll<HTMLElement>('[data-sg]')) {
    const msgs: Record<string, string> = JSON.parse(root.querySelector('[data-sg-msgs]')!.textContent!);
    const len = root.querySelector<HTMLInputElement>('[data-sg-length]')!;
    const range = root.querySelector<HTMLInputElement>('[data-sg-range]')!;
    const count = root.querySelector<HTMLInputElement>('[data-sg-count]')!;
    const list = root.querySelector<HTMLElement>('[data-sg-list]')!;
    const charset = () => (root.querySelector<HTMLInputElement>('input[name="charset"]:checked')?.value ?? 'hex') as Charset;

    // Only the settings are remembered, never the generated values
    try {
      const s = JSON.parse(localStorage.getItem(KEY) ?? '{}');
      if (s.length) len.value = String(clampLength(s.length));
      if (s.charset && s.charset in charsets) root.querySelectorAll<HTMLInputElement>('input[name="charset"]').forEach((i) => (i.checked = i.value === s.charset));
      if (s.count) count.value = String(Math.min(10, Math.max(1, s.count)));
    } catch {}

    function render() {
      const n = clampLength(Number(len.value));
      const cs = charset();
      const c = Math.min(10, Math.max(1, Math.round(Number(count.value)) || 1));
      range.value = String(Math.min(n, 128));
      list.replaceChildren(
        ...Array.from({ length: c }, () => {
          const value = randomString(n, charsets[cs]);
          const li = document.createElement('li');
          const code = document.createElement('code');
          code.textContent = value;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'copy-btn';
          btn.textContent = msgs.copy;
          btn.addEventListener('click', () => copyText(btn, value));
          li.append(code, btn);
          return li;
        }),
      );
      root.querySelector('[data-sg-bits]')!.textContent = msgs.bits.replace('{n}', String(n)).replace('{bits}', String(entropyBits(n, cs)));
      root.querySelector('[data-sg-cmd]')!.textContent = shellCommand(n, cs);
      try {
        localStorage.setItem(KEY, JSON.stringify({ length: n, charset: cs, count: c }));
      } catch {}
    }

    range.addEventListener('input', () => {
      len.value = range.value;
      render();
    });
    len.addEventListener('change', () => {
      len.value = String(clampLength(Number(len.value)));
      render();
    });
    len.addEventListener('input', () => Number(len.value) >= 8 && render());
    count.addEventListener('change', render);
    root.querySelectorAll('input[name="charset"]').forEach((i) => i.addEventListener('change', render));
    root.querySelectorAll<HTMLButtonElement>('[data-sg-preset]').forEach((b) =>
      b.addEventListener('click', () => {
        len.value = b.dataset.sgPreset!;
        render();
      }),
    );
    root.querySelector('[data-sg-new]')!.addEventListener('click', render);
    render();
  }
</script>

<style>
  .sg { padding: 24px; display: flex; flex-direction: column; gap: 18px; }
  .sg-head { display: flex; flex-direction: column; gap: 6px; }
  .sg-head h2 { font-size: 19px; font-weight: 700; }
  .sg-form { display: flex; flex-direction: column; gap: 14px; }
  label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600; color: var(--text-4); }
  input[type='number'] { height: 42px; border: 1.5px solid var(--line-2); border-radius: 12px; padding: 0 12px; font-family: var(--mono); font-size: 14px; color: var(--accent-600); background: #f7fafc; width: 110px; }
  input[type='number']:focus { border-color: var(--accent); outline: none; }
  .len-row { display: flex; gap: 12px; align-items: center; }
  .len-row input[type='range'] { flex: 1; min-width: 0; accent-color: var(--accent); }
  .presets { display: flex; gap: 6px; flex-wrap: wrap; }
  .chip-btn { border: 1.5px solid var(--line-2); background: #fff; border-radius: 999px; padding: 4px 12px; font-family: var(--mono); font-size: 13px; color: var(--text-2); }
  .chip-btn:hover { border-color: var(--accent); }
  .sets { border: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 8px; }
  .sets legend { padding: 0; margin-bottom: 8px; font-size: 13px; font-weight: 600; color: var(--text-4); }
  .set { flex-direction: row; gap: 10px; align-items: flex-start; border: 1.5px solid var(--line-2); border-radius: 12px; padding: 10px 12px; cursor: pointer; font-weight: 400; }
  .set:has(input:checked) { border-color: var(--accent); background: var(--accent-50); }
  .set input { margin-top: 3px; accent-color: var(--accent); }
  .set span { display: flex; flex-direction: column; gap: 2px; }
  .set b { font-size: 14px; color: var(--text); }
  .set small { font-size: 12.5px; color: var(--muted); line-height: 1.4; }
  .count input { width: 80px; }
  .sg-out { display: flex; flex-direction: column; gap: 10px; border-top: 1px solid var(--line-3); padding-top: 16px; }
  .sg-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .list :global(li) { display: flex; gap: 10px; align-items: center; background: var(--bg); border-radius: 12px; padding: 10px 12px; }
  .list :global(code) { flex: 1; min-width: 0; font-family: var(--mono); font-size: 14px; color: var(--accent-700); overflow-wrap: anywhere; }
  .list :global(.copy-btn) { position: static; flex: none; }
  .small { font-size: 13px; }
</style>
