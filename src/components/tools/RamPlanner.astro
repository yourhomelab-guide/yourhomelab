---
/**
 * RAM planner: pick services (shared "Mein Stack" selection), add the base load, see the sum as a stacked bar and a
 * RAM size recommendation. Calculation lives in src/lib/tools/ram.ts.
 */
import ServiceLogo from '../ServiceLogo.astro';
import { categories } from '../../config/site';
import { getServices, getWiki } from '../../lib/content';
import { t, type Lang } from '../../lib/i18n';
import { url } from '../../lib/routes';
import { RAM_DOCKER, RAM_FALLBACK, RAM_OS, RAM_PROXMOX } from '../../lib/tools/ram';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const k = (key: string, vars?: Record<string, string | number>) => t(lang, `tools.ram-planner.${key}`, vars);

const services = await getServices(lang);
const groups = categories.map((c) => ({ cat: c, items: services.filter((s) => s.category === c) })).filter((g) => g.items.length);
const wiki = (await getWiki(lang)).items;
const hwSlug = wiki.find((w) => w.id === 'hardware-overview')?.slug ?? 'hardware-overview';

const loc = lang === 'de' ? 'de-DE' : 'en-US';
const fmtMb = (mb: number) => (mb < 1024 ? `${mb} MB` : `${new Intl.NumberFormat(loc, { maximumFractionDigits: 1 }).format(mb / 1024)} GB`);

const data = {
  lang,
  services: services.map((s) => ({ id: s.id, name: s.name, ram: s.resources?.ram, gpu: s.resources?.gpu ?? 'no' })),
  text: {
    os: k('os'),
    docker: k('docker'),
    proxmox: k('proxmox'),
    buffer: k('buffer'),
    estimated: k('estimated'),
    tier4: k('tier4'),
    tier8: k('tier8'),
    tier16: k('tier16'),
    tier32: k('tier32'),
    why: k('why'),
    why32: k('why32'),
    gpuOptional: k('gpuOptional'),
    gpuRecommended: k('gpuRecommended'),
    immich: k('immich'),
    proxmoxNote: k('proxmoxNote'),
    selected: k('selected'),
  },
};
---

<div class="ram" data-ram>
  <script type="application/json" data-ram-data set:html={JSON.stringify(data)} />

  <section class="card panel" aria-labelledby="ram-pick">
    <div class="p-head">
      <h2 id="ram-pick" class="h3">{k('pick')}</h2>
      <span class="muted count" data-count aria-live="polite"></span>
      <button type="button" class="btn btn-soft btn-sm" data-clear>{k('clear')}</button>
    </div>
    <p class="muted small">{k('pickHint')}</p>
    <div class="groups">
      {
        groups.map((g) => (
          <fieldset>
            <legend>{t(lang, `category.${g.cat}`)}</legend>
            <div class="svc-list">
              {g.items.map((s) => (
                <label class="svc">
                  <input type="checkbox" value={s.id} data-svc />
                  <span class="svc-box">
                    <ServiceLogo name={s.name} logo={s.logo} size={24} />
                    <span class="svc-name">{s.name}</span>
                    <span class="svc-ram" title={s.resources?.ram == null ? k('estimated') : undefined}>
                      ~{fmtMb(s.resources?.ram ?? RAM_FALLBACK)}
                      {s.resources?.ram == null && '*'}
                    </span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        ))
      }
    </div>
    {services.some((s) => s.resources?.ram == null) && <p class="muted small">* {k('estNote', { mb: RAM_FALLBACK })}</p>}
  </section>

  <section class="card panel" aria-labelledby="ram-base">
    <h2 id="ram-base" class="h3">{k('base')}</h2>
    <ul class="base-list">
      <li><span>{k('os')}</span><span class="mono">~{fmtMb(RAM_OS)}</span></li>
      <li><span>{k('docker')}</span><span class="mono">~{fmtMb(RAM_DOCKER)}</span></li>
    </ul>
    <label class="check">
      <input type="checkbox" data-proxmox />
      <span>{k('proxmox')} <span class="mono">+~{fmtMb(RAM_PROXMOX)}</span><br /><span class="muted small">{k('proxmoxHint')}</span></span>
    </label>
    <div class="buf">
      <span class="lbl" id="ram-buf-l">{k('buffer')}</span>
      <div class="row" role="radiogroup" aria-labelledby="ram-buf-l">
        {
          [0, 10, 25, 50].map((p) => (
            <label class="opt">
              <input type="radio" name="ram-buffer" value={p} checked={p === 25} data-buffer />
              <span>{p} %</span>
            </label>
          ))
        }
      </div>
      <p class="muted small">{k('bufferHint')}</p>
    </div>
  </section>

  <section class="card panel result" aria-labelledby="ram-result" aria-live="polite">
    <div class="res-top">
      <div>
        <h2 id="ram-result" class="eyebrow">{k('total')}</h2>
        <p class="sum" data-total>–</p>
      </div>
      <div class="tier" data-tier-box>
        <p class="tier-t" data-tier></p>
        <p class="small" data-why></p>
      </div>
    </div>
    <div class="bar" data-bar role="img" aria-label={k('barLabel')}></div>
    <ul class="legend" data-legend></ul>
    <div class="notes" data-notes></div>
  </section>

  <p class="links">
    <a href={url.wiki(lang, hwSlug)}>{k('linkHw')} →</a>
    <a href={url.tool(lang, 'power-calculator')}>{k('linkPower')} →</a>
  </p>
</div>

<script>
  import { getStack, setStack } from '../../client/stack';
  import { planRam, type RamPart } from '../../lib/tools/ram';

  interface Data {
    lang: 'de' | 'en';
    services: { id: string; name: string; ram?: number; gpu: 'no' | 'optional' | 'recommended' }[];
    text: Record<string, string>;
  }

  const PREF = 'yhl-ram-planner';

  for (const root of document.querySelectorAll<HTMLElement>('[data-ram]')) {
    const data: Data = JSON.parse(root.querySelector('[data-ram-data]')!.textContent!);
    const T = data.text;
    const loc = data.lang === 'de' ? 'de-DE' : 'en-US';
    const nf = new Intl.NumberFormat(loc, { maximumFractionDigits: 1 });
    const fmt = (mb: number) => (mb < 1024 ? `${Math.round(mb)} MB` : `${nf.format(mb / 1024)} GB`);
    const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, x) => String(v[x] ?? ''));
    const byId = new Map(data.services.map((s) => [s.id, s]));
    const boxes = [...root.querySelectorAll<HTMLInputElement>('[data-svc]')];
    const proxmox = root.querySelector<HTMLInputElement>('[data-proxmox]')!;
    const buffers = [...root.querySelectorAll<HTMLInputElement>('[data-buffer]')];

    // Per-viewer preferences (Proxmox, buffer); the service selection is the shared stack
    try {
      const p = JSON.parse(localStorage.getItem(PREF) ?? '{}');
      if (typeof p.proxmox === 'boolean') proxmox.checked = p.proxmox;
      if (typeof p.buffer === 'number') buffers.forEach((b) => (b.checked = Number(b.value) === p.buffer));
    } catch {}

    const colorOf = (i: number) => `hsl(${(195 + i * 47) % 360} 60% ${i % 2 ? 58 : 46}%)`;

    function segment(bar: HTMLElement, legend: HTMLElement, part: { label: string; mb: number; cls?: string; color?: string; est?: boolean }, total: number) {
      const seg = document.createElement('span');
      seg.className = `seg ${part.cls ?? ''}`;
      seg.style.width = `${(part.mb / total) * 100}%`;
      if (part.color) seg.style.background = part.color;
      seg.title = `${part.label}: ~${fmt(part.mb)}`;
      bar.append(seg);
      const li = document.createElement('li');
      const dot = document.createElement('span');
      dot.className = `dot ${part.cls ?? ''}`;
      if (part.color) dot.style.background = part.color;
      const name = document.createElement('span');
      name.textContent = part.label + (part.est ? ` (${T.estimated})` : '');
      const val = document.createElement('span');
      val.className = 'mono';
      val.textContent = `~${fmt(part.mb)}`;
      li.append(dot, name, val);
      legend.append(li);
    }

    function render() {
      const stack = getStack();
      boxes.forEach((b) => (b.checked = stack.includes(b.value)));
      const chosen = data.services.filter((s) => stack.includes(s.id));
      const buffer = Number(buffers.find((b) => b.checked)?.value ?? 25);
      const r = planRam({ services: chosen, proxmox: proxmox.checked, buffer });

      root.querySelector('[data-count]')!.textContent = fill(T.selected, { n: chosen.length });
      root.querySelector('[data-total]')!.textContent = `~${fmt(r.total)}`;
      const tierBox = root.querySelector<HTMLElement>('[data-tier-box]')!;
      tierBox.dataset.level = String(r.tier);
      root.querySelector('[data-tier]')!.textContent = T[`tier${r.tier}`];
      root.querySelector('[data-why]')!.textContent =
        r.tier === 32 ? T.why32 : fill(T.why, { total: fmt(r.total), size: `${r.tier} GB`, free: fmt(r.tier * 1024 - r.total) });

      const bar = root.querySelector<HTMLElement>('[data-bar]')!;
      const legend = root.querySelector<HTMLElement>('[data-legend]')!;
      bar.replaceChildren();
      legend.replaceChildren();
      const baseLabel: Record<string, string> = { os: T.os, docker: T.docker, proxmox: T.proxmox };
      r.base.forEach((p: RamPart) => segment(bar, legend, { label: baseLabel[p.id], mb: p.mb, cls: `base base-${p.id}` }, r.total));
      r.services.forEach((p: RamPart, i: number) =>
        segment(bar, legend, { label: byId.get(p.id)!.name, mb: p.mb, color: colorOf(i), est: p.estimated }, r.total),
      );
      if (r.bufferMb > 0) segment(bar, legend, { label: `${T.buffer} (${buffer} %)`, mb: r.bufferMb, cls: 'buffer' }, r.total);

      const notes = root.querySelector<HTMLElement>('[data-notes]')!;
      notes.replaceChildren();
      const note = (text: string) => {
        const p = document.createElement('p');
        p.className = 'note';
        p.textContent = text;
        notes.append(p);
      };
      const opt = chosen.filter((s) => s.gpu === 'optional').map((s) => s.name);
      const rec = chosen.filter((s) => s.gpu === 'recommended').map((s) => s.name);
      if (rec.length) note(fill(T.gpuRecommended, { list: rec.join(', ') }));
      if (opt.length) note(fill(T.gpuOptional, { list: opt.join(', ') }));
      if (stack.includes('immich')) note(T.immich);
      if (proxmox.checked) note(T.proxmoxNote);
    }

    boxes.forEach((b) =>
      b.addEventListener('change', () => {
        const s = new Set(getStack());
        b.checked ? s.add(b.value) : s.delete(b.value);
        setStack([...s]);
      }),
    );
    root.querySelector('[data-clear]')!.addEventListener('click', () => {
      const own = new Set(boxes.map((b) => b.value));
      setStack(getStack().filter((id) => !own.has(id)));
    });
    const savePrefs = () => {
      try {
        localStorage.setItem(PREF, JSON.stringify({ proxmox: proxmox.checked, buffer: Number(buffers.find((b) => b.checked)?.value ?? 25) }));
      } catch {}
      render();
    };
    proxmox.addEventListener('change', savePrefs);
    buffers.forEach((b) => b.addEventListener('change', savePrefs));
    document.addEventListener('yhl:stack', render);
    window.addEventListener('storage', (e) => e.key === 'yhl-stack' && render());
    render();
  }
</script>

<style>
  .ram { display: flex; flex-direction: column; gap: 20px; }
  .panel { border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .p-head { display: flex; align-items: center; gap: 10px 14px; flex-wrap: wrap; }
  .p-head h2 { margin-right: auto; }
  .h3 { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; }
  .small { font-size: 13.5px; }
  .count { font-size: 13.5px; }
  .groups { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px 22px; }
  fieldset { border: none; margin: 0; padding: 0; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  legend { padding: 0; margin-bottom: 8px; font-size: 12.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
  .svc-list { display: flex; flex-direction: column; gap: 6px; }
  .svc { position: relative; display: block; cursor: pointer; }
  .svc input { position: absolute; opacity: 0; pointer-events: none; }
  .svc-box {
    display: flex; align-items: center; gap: 10px; padding: 8px 12px 8px 36px; border: 1.5px solid var(--line-2); border-radius: 12px;
    background: var(--surface); font-size: 14.5px; position: relative; min-width: 0;
  }
  .svc-box::before {
    content: ''; position: absolute; left: 12px; top: 50%; width: 16px; height: 16px; margin-top: -8px; border: 1.5px solid var(--line-2);
    border-radius: 5px; background: var(--surface);
  }
  .svc input:checked + .svc-box { border-color: var(--accent); background: var(--accent-50); }
  .svc input:checked + .svc-box::before {
    background: var(--accent); border-color: var(--accent);
    box-shadow: inset 0 0 0 3px var(--accent-50);
  }
  .svc input:focus-visible + .svc-box { outline: 2px solid var(--accent); outline-offset: 2px; }
  .svc-box :global(.svc-logo), .svc-box :global(.svc-initial) { width: 24px; height: 24px; flex: none; }
  .svc-name { font-weight: 600; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .svc-ram { font-family: var(--mono); font-size: 12.5px; color: var(--text-4); white-space: nowrap; }

  .base-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 14.5px; }
  .base-list li { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--line-2); }
  .mono { font-family: var(--mono); font-size: 13px; color: var(--text-4); white-space: nowrap; }
  .check { display: flex; gap: 10px; align-items: flex-start; font-size: 14.5px; cursor: pointer; }
  .check input { width: 18px; height: 18px; margin-top: 2px; accent-color: var(--accent); flex: none; }
  .buf { display: flex; flex-direction: column; gap: 8px; }
  .lbl { font-size: 13px; font-weight: 600; color: var(--text-4); }
  .row { display: flex; gap: 8px; flex-wrap: wrap; }
  .opt { position: relative; }
  .opt input { position: absolute; opacity: 0; pointer-events: none; }
  .opt span {
    display: inline-block; border: 1.5px solid var(--line-2); background: var(--surface); color: var(--text-2); border-radius: 999px;
    padding: 7px 14px; font-size: 13.5px; cursor: pointer;
  }
  .opt input:checked + span { border-color: var(--accent); background: var(--accent-50); color: var(--accent-600); font-weight: 600; }
  .opt input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }

  .res-top { display: flex; gap: 16px 28px; flex-wrap: wrap; align-items: flex-start; }
  .sum { font-size: 34px; font-weight: 700; letter-spacing: -0.02em; margin-top: 4px; }
  .tier { flex: 1; min-width: 220px; border-radius: 14px; padding: 12px 16px; background: var(--accent-50); color: var(--accent-600); }
  .tier[data-level='16'], .tier[data-level='32'] { background: var(--warn-bg); color: var(--warn-fg); }
  .tier-t { font-weight: 700; font-size: 17px; }
  .tier .small { margin-top: 4px; }
  .bar { display: flex; height: 28px; border-radius: 10px; overflow: hidden; background: var(--bg); border: 1px solid var(--line-2); }
  .bar :global(.seg) { height: 100%; min-width: 2px; border-right: 1px solid var(--surface); }
  .bar :global(.seg:last-child) { border-right: none; }
  .ram :global(.base-os) { background: #8a99a8; }
  .ram :global(.base-docker) { background: #aab7c4; }
  .ram :global(.base-proxmox) { background: #6b7b8c; }
  .ram :global(.buffer) { background: repeating-linear-gradient(135deg, var(--line-2) 0 6px, var(--bg) 6px 12px); }
  .legend { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 6px 20px; font-size: 13.5px; }
  .legend :global(li) { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .legend :global(li > span:nth-child(2)) { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .legend :global(.dot) { width: 12px; height: 12px; border-radius: 4px; flex: none; }
  .notes { display: flex; flex-direction: column; gap: 8px; }
  .notes :global(.note) { font-size: 14px; line-height: 1.5; padding: 10px 14px; border-radius: 12px; background: var(--warn-bg); color: var(--warn-fg); }
  .links { display: flex; gap: 8px 22px; flex-wrap: wrap; font-size: 14.5px; }
  @media (max-width: 480px) {
    .panel { padding: 16px; }
    .groups { grid-template-columns: 1fr; }
    .sum { font-size: 28px; }
  }
</style>
