---
/**
 * Markdown tables. Tables wrap their text and fit the column where possible; when a table is still wider than the
 * page, the hint and the faded edges show that it scrolls sideways (see src/client/tables.ts).
 */
import { langFromUrl, t } from '../../lib/i18n';

const props = Astro.props;
const lang = langFromUrl(Astro.url);
---

<div class="table-wrap at-start">
  <span class="table-hint" aria-hidden="true">{t(lang, 'table.scrollHint')}</span>
  <div class="table-frame">
    <div class="table-scroll" tabindex="0" role="region" aria-label={t(lang, 'table.label')}>
      <table {...props}><slot /></table>
    </div>
  </div>
</div>
