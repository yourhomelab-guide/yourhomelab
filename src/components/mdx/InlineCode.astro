---
/** Inline `code`. Placeholders like `__ROOT__` are shown with the visitor's value. */
import { appDataDir, defaultSetup } from '../../config/site';
import { PH_RE, phAttrs } from '../../lib/highlight';
import { langFromUrl, placeholderDefaults } from '../../lib/i18n';

const html = await Astro.slots.render('default');
const values = placeholderDefaults(langFromUrl(Astro.url));
const out = html.replace(PH_RE, (m, k, arg) => {
  const val = arg !== undefined ? appDataDir(defaultSetup, arg) : values[k];
  return val !== undefined ? `<span class="tk-var" ${phAttrs(k, arg)}>${val}</span>` : m;
});
---

<code set:html={out} />
