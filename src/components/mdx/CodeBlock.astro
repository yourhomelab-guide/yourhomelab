---
/**
 * Replaces fenced code blocks in MDX. Supports placeholders like __DOMAIN__ (see CONTRIBUTING.md).
 */
import { renderCode } from '../../lib/highlight';
import { langFromUrl, placeholderDefaults, t } from '../../lib/i18n';

const lang = langFromUrl(Astro.url);
const html = await Astro.slots.render('default');
const code = html
  .replace(/<span[^>]*data-ph="(\w+)"(?: data-arg="([^"]*)")?[^>]*>[\s\S]*?<\/span>/g, (_, ph, arg) => `__${ph}${arg !== undefined ? `(${arg})` : ''}__`)
  .replace(/<[^>]+>/g, '')
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/&quot;/g, '"')
  .replace(/&#x27;|&#39;/g, "'")
  .replace(/&#x60;/g, '`')
  .replace(/&amp;/g, '&')
  .replace(/^\n+|\n+$/g, '');
---

<div class="code">
  <pre set:html={renderCode(code, { values: placeholderDefaults(lang) })} />
  <button type="button" class="copy-btn" data-copy>{t(lang, 'code.copy')}</button>
</div>
