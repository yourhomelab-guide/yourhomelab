---
import { langs, t, type Lang } from '../lib/i18n';
import { url, type Section } from '../lib/routes';

interface Props {
  lang: Lang;
  nav?: Section;
  alternates: Partial<Record<Lang, string>>;
}
const { lang, nav, alternates } = Astro.props;
const items: [Section, string][] = [
  ['home', 'nav.start'],
  ['wiki', 'nav.wiki'],
  ['setup', 'nav.setup'],
  ['services', 'nav.services'],
];
---

<header class="hdr">
  <div class="wrap hdr-in">
    <a class="logo" href={url.section(lang, 'home')} aria-label={t(lang, 'header.home')}>
      <span class="logo-mark"><span></span></span>yourhomelab
    </a>
    <nav class="nav" aria-label="Main">
      {
        items.map(([s, key]) => (
          <a href={url.section(lang, s)} aria-current={nav === s ? 'page' : undefined}>
            {t(lang, key)}
          </a>
        ))
      }
    </nav>
    <button type="button" class="search-btn" data-search-open aria-keyshortcuts="Control+K Meta+K">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 20 20"></path></svg>
      <span class="search-label">{t(lang, 'header.search')}</span>
    </button>
    <div class="lang" role="group" aria-label={t(lang, 'lang.switch')}>
      {
        langs.map((l) =>
          l === lang ? (
            <span aria-current="true" lang={l}>{l.toUpperCase()}</span>
          ) : (
            <a href={alternates[l] ?? url.section(l, 'home')} hreflang={l} lang={l} title={t(l, 'lang.name')}>
              {l.toUpperCase()}
            </a>
          ),
        )
      }
    </div>
    <button type="button" class="setup-btn" data-setup-open>
      <span class="dot"></span><span class="setup-label">{t(lang, 'header.mySetup')}</span>
    </button>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 20; background: var(--surface); border-bottom: 1px solid var(--line); }
  .hdr-in { min-height: var(--header-h); display: flex; align-items: center; gap: 16px; padding-inline: 24px; }
  .logo { display: flex; align-items: center; gap: 10px; font-size: 19px; font-weight: 700; letter-spacing: -0.02em; color: var(--text); flex: none; }
  .logo:hover { text-decoration: none; color: var(--text); }
  .logo-mark { width: 26px; height: 26px; border-radius: 8px; background: var(--accent); display: flex; align-items: center; justify-content: center; }
  .logo-mark span { width: 10px; height: 10px; border-radius: 3px; background: #fff; }
  .nav { display: flex; gap: 2px; font-size: 14.5px; font-weight: 500; flex: none; }
  .nav a { padding: 8px 14px; border-radius: 999px; color: var(--text-4); white-space: nowrap; }
  .nav a:hover { background: var(--bg); color: var(--text); text-decoration: none; }
  .nav a[aria-current='page'] { background: var(--accent-50); color: var(--accent-600); font-weight: 600; }
  .search-btn {
    margin-left: auto; flex: 0 1 300px; min-width: 40px; height: 40px; border: none; border-radius: 999px; background: var(--bg);
    display: flex; align-items: center; padding: 0 16px; gap: 10px; font-size: 14px; color: var(--muted); text-align: left;
  }
  .search-btn svg { flex: none; }
  .search-btn span { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lang { display: flex; align-items: center; height: 40px; padding: 3px; border-radius: 999px; background: var(--bg); font-size: 12.5px; font-weight: 700; letter-spacing: 0.04em; flex: none; }
  .lang > * { height: 34px; min-width: 38px; display: flex; align-items: center; justify-content: center; border-radius: 999px; padding: 0 8px; }
  .lang span { background: var(--surface); color: var(--accent-600); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08); }
  .lang a { color: var(--muted); }
  .lang a:hover { color: var(--text); text-decoration: none; }
  .setup-btn {
    height: 40px; border: 1.5px solid var(--line-2); border-radius: 999px; background: var(--surface); flex: none;
    display: flex; align-items: center; gap: 8px; padding: 0 14px; font-size: 13.5px; font-weight: 600; color: var(--text); white-space: nowrap;
  }
  .setup-btn:hover { border-color: var(--accent); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }

  @media (max-width: 1060px) {
    .hdr-in { flex-wrap: wrap; row-gap: 0; padding-inline: var(--gutter); }
    .nav { order: 10; width: calc(100% + 2 * var(--gutter)); margin-inline: calc(-1 * var(--gutter)); padding: 0 calc(var(--gutter) - 8px) 10px; overflow-x: auto; scrollbar-width: none; }
    .nav::-webkit-scrollbar { display: none; }
    .search-btn { flex-basis: 220px; }
  }
  @media (max-width: 720px) {
    .hdr-in { gap: 8px; }
    .search-btn { flex: 0 0 40px; padding: 0; justify-content: center; }
    .search-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .setup-btn { padding: 0 12px; }
    .setup-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .logo { font-size: 17px; }
  }
</style>
