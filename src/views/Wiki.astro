---
/** Wiki index (no article) or a single wiki article with sidebar and table of contents. */
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Level from '../components/Level.astro';
import Notice from '../components/Notice.astro';
import PageFooter from '../components/PageFooter.astro';
import { mdxComponents } from '../components/mdx';
import { site, sourceLang } from '../config/site';
import { getSetupPath, getWiki, readingTime, sourcePath, type WikiArticle } from '../lib/content';
import { t, type Lang } from '../lib/i18n';
import { url } from '../lib/routes';

interface Props {
  lang: Lang;
  article?: WikiArticle;
}
const { lang, article } = Astro.props;
const wiki = await getWiki(lang);
const { guides } = await getSetupPath(lang);

let Content: any = null;
let headings: { depth: number; slug: string; text: string }[] = [];
if (article) ({ Content, headings } = await render(article.entry));
const data = article?.entry.data;
const stub = article?.source.data.status === 'stub';
const file = article ? sourcePath(article.entry) : '';
const related = (data?.related ?? []).map((id) => wiki.items.find((i) => i.id === id)).filter(Boolean) as WikiArticle[];
const practice = data?.practice ? guides.find((g) => g.id === data.practice) : undefined;
const groupTitle = (id: string) => t(lang, `wiki.group.${id}`);
const alternates = article ? { de: url.wiki('de', article.slugs.de), en: url.wiki('en', article.slugs.en) } : { de: url.section('de', 'wiki'), en: url.section('en', 'wiki') };
---

<Base lang={lang} title={data?.title ?? t(lang, 'wiki.title')} description={data?.description} alternates={alternates} nav="wiki" noindex={stub}>
  <div class="wrap wiki">
    <aside class="side">
      <label class="filter">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#7C8894" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 20 20"></path></svg>
        <input type="search" placeholder={t(lang, 'wiki.filter')} aria-label={t(lang, 'wiki.filter')} data-wiki-filter />
      </label>
      <span class="nohits" data-wiki-nohits hidden>{t(lang, 'wiki.noHits')}</span>
      <nav class="groups" aria-label={t(lang, 'wiki.title')}>
        {
          wiki.groups.map((g) => (
            <div class="group" data-wiki-group>
              <div class="eyebrow gtitle">{groupTitle(g.id)}</div>
              {g.items.map((it) => (
                <a
                  href={url.wiki(lang, it.slug)}
                  class:list={['item', { stub: it.source.data.status === 'stub' }]}
                  aria-current={it.slug === article?.slug ? 'page' : undefined}
                  data-wiki-item={`${it.entry.data.title} ${groupTitle(g.id)}`.toLowerCase()}
                >
                  {it.entry.data.title}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
      <div class="notyet">
        <strong>{t(lang, 'wiki.notYetTitle')}</strong>
        <span set:html={t(lang, 'wiki.notYetText')} />
        <a href={`${site.repo}/discussions`}>{t(lang, 'wiki.notYetLink')} ↗</a>
      </div>
    </aside>

    {
      article ? (
        <article class="main">
          <div class="crumbs">
            <a href={url.section(lang, 'wiki')}>{t(lang, 'wiki.title')}</a>
            <span>/</span>
            <span>{groupTitle(article.group)}</span>
          </div>
          <h1 class="h1">{data!.title}</h1>
          <div class="meta">
            <Level lang={lang} level={data!.level} />
            {!stub && <span class="pill">{t(lang, 'wiki.readingTime', { n: readingTime(article.entry.body) })}</span>}
          </div>
          {!article.translated && <Notice lang={lang} kind="untranslated" file={file} />}
          {data!.description && <p class="lead-lg">{data!.description}</p>}
          {stub ? (
            <Notice lang={lang} kind="stub" file={sourcePath(article.source)} />
          ) : (
            <div class="prose" lang={article.translated ? undefined : sourceLang}>
              <Content components={mdxComponents} />
            </div>
          )}
          <PageFooter lang={lang} file={file} />
        </article>
      ) : (
        <main class="main">
          <h1 class="h1">{t(lang, 'wiki.title')}</h1>
          <p class="lead-lg">{t(lang, 'wiki.lead')}</p>
          <div class="overview">
            {wiki.groups.map((g) => (
              <section class="ov card">
                <div class="ov-head">
                  <h2>{groupTitle(g.id)}</h2>
                  <span class="muted">{t(lang, 'wiki.articles', { n: g.items.length })}</span>
                </div>
                {g.items.map((it) => (
                  <a href={url.wiki(lang, it.slug)} class:list={['ov-item', { stub: it.source.data.status === 'stub' }]}>
                    <span>{it.entry.data.title}</span>
                    <Level lang={lang} level={it.entry.data.level} />
                  </a>
                ))}
              </section>
            ))}
          </div>
        </main>
      )
    }

    <aside class="toc">
      {
        headings.filter((h) => h.depth === 2).length > 0 && (
          <div class="toc-sec">
            <span class="eyebrow">{t(lang, 'wiki.onThisPage')}</span>
            {headings
              .filter((h) => h.depth === 2)
              .map((h) => (
                <a href={`#${h.slug}`}>{h.text}</a>
              ))}
          </div>
        )
      }
      {
        related.length > 0 && (
          <div class="toc-sec">
            <span class="eyebrow">{t(lang, 'wiki.related')}</span>
            {related.map((r) => (
              <a class="rel" href={url.wiki(lang, r.slug)}>
                {r.entry.data.title}
              </a>
            ))}
          </div>
        )
      }
      {
        practice && (
          <a class="practice card" href={url.guide(lang, practice.slug)}>
            <span>{t(lang, 'wiki.practice')}</span>
            <strong>
              {t(lang, 'setup.stage', { n: String(practice.stage.n).padStart(2, '0') })} · {practice.entry.data.title} →
            </strong>
          </a>
        )
      }
    </aside>
  </div>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-wiki-filter]');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let any = false;
    document.querySelectorAll<HTMLElement>('[data-wiki-group]').forEach((g) => {
      let vis = 0;
      g.querySelectorAll<HTMLElement>('[data-wiki-item]').forEach((it) => {
        const show = !q || it.dataset.wikiItem!.includes(q);
        it.hidden = !show;
        if (show) vis++;
      });
      g.hidden = vis === 0;
      any ||= vis > 0;
    });
    document.querySelector<HTMLElement>('[data-wiki-nohits]')!.hidden = any;
  });

  // Keep the sidebar where it was when moving between articles (it has its own scroll area on wide screens)
  const side = document.querySelector<HTMLElement>('.side');
  const KEY = 'yhl-wiki-side';
  if (side && getComputedStyle(side).position === 'sticky') {
    try {
      const y = sessionStorage.getItem(KEY);
      if (y) side.scrollTop = Number(y);
    } catch {}
    const cur = side.querySelector<HTMLElement>('[aria-current="page"]');
    if (cur) {
      const r = cur.getBoundingClientRect();
      const s = side.getBoundingClientRect();
      if (r.top < s.top || r.bottom > s.bottom) side.scrollTop += r.top - s.top - s.height / 2;
    }
    addEventListener('pagehide', () => {
      try {
        sessionStorage.setItem(KEY, String(side.scrollTop));
      } catch {}
    });
  }
</script>

<style is:global>
  /* Cross-document transition between wiki pages: the content fades, the sidebar stays put */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }
</style>

<style>
  .wiki { display: grid; grid-template-columns: 260px minmax(0, 1fr) 240px; gap: 48px; align-items: start; }
  .side { position: sticky; top: var(--header-h); max-height: calc(100vh - var(--header-h)); overflow-y: auto; padding: 32px 0 40px; display: flex; flex-direction: column; gap: 22px; scrollbar-width: thin; view-transition-name: wiki-side; }
  .filter { height: 52px; flex: none; border-radius: 14px; background: var(--surface); border: 1.5px solid var(--line-2); display: flex; align-items: center; gap: 10px; padding: 0 12px 0 14px; cursor: text; }
  .filter:focus-within { border-color: var(--accent); }
  .filter svg { flex: none; }
  .filter input { flex: 1; min-width: 0; border: none; background: none; font-size: 15px; padding: 0; outline: none; }
  .nohits { font-size: 13.5px; color: var(--muted); padding: 0 4px; }
  .groups { display: flex; flex-direction: column; gap: 22px; }
  .group { display: flex; flex-direction: column; gap: 1px; }
  .gtitle { padding: 0 10px 6px; }
  .item { font-size: 14px; padding: 7px 10px; border-radius: 10px; color: var(--text-2); }
  .item:hover { background: #e8eff3; text-decoration: none; color: var(--text); }
  .item[aria-current='page'] { background: var(--accent-50); color: var(--accent-600); font-weight: 600; }
  .item.stub:not([aria-current]) { color: var(--muted); }
  .notyet { border: 2px dashed var(--dash); border-radius: 16px; padding: 16px; display: flex; flex-direction: column; gap: 8px; font-size: 13px; line-height: 1.5; color: var(--text-4); }
  .notyet strong { font-size: 14px; color: var(--text); }
  .notyet :global(strong) { color: var(--text); }
  .notyet a { font-weight: 600; }

  .main { padding: 44px 0 88px; display: flex; flex-direction: column; gap: 22px; min-width: 0; }
  .crumbs { font-size: 13.5px; color: var(--muted); display: flex; gap: 8px; }
  .meta { display: flex; gap: 8px; flex-wrap: wrap; }
  .meta :global(.lvl) { font-size: 13.5px; font-weight: 500; padding: 6px 12px; }
  .lead-lg { font-size: 18.5px; line-height: 1.65; color: var(--text-2); text-wrap: pretty; }

  .overview { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .ov { padding: 22px; display: flex; flex-direction: column; gap: 4px; }
  .ov-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-bottom: 8px; font-size: 13px; }
  .ov-head h2 { font-size: 19px; font-weight: 700; }
  .ov-item { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--line-3); color: var(--text-2); font-size: 14.5px; }
  .ov-item:last-child { border-bottom: none; }
  .ov-item:hover { color: var(--accent-600); text-decoration: none; }
  .ov-item.stub span:first-child { color: var(--muted); }
  .ov-item :global(.lvl) { font-size: 11.5px; padding: 3px 8px; }

  .toc { position: sticky; top: var(--header-h); padding: 44px 0; display: flex; flex-direction: column; gap: 28px; }
  .toc-sec { display: flex; flex-direction: column; gap: 10px; font-size: 14px; }
  .toc-sec a { color: var(--text-2); }
  .toc-sec a:hover { color: var(--accent-600); text-decoration: none; }
  .toc-sec a.rel { color: var(--accent-600); }
  .practice { border-radius: 16px; padding: 16px; display: flex; flex-direction: column; gap: 4px; color: var(--text); }
  .practice:hover { box-shadow: var(--ring); text-decoration: none; color: var(--text); }
  .practice span { font-size: 12.5px; color: var(--muted); }
  .practice strong { font-size: 14.5px; font-weight: 600; }

  @media (max-width: 1180px) {
    .wiki { grid-template-columns: 240px minmax(0, 1fr); gap: 40px; }
    .toc { grid-column: 2; position: static; padding-top: 0; margin-top: -56px; }
  }
  @media (max-width: 860px) {
    .wiki { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .side { position: static; max-height: none; order: 3; padding-top: 0; }
    .main { padding-top: 32px; }
    .toc { grid-column: auto; margin-top: -40px; padding-bottom: 40px; }
  }
</style>
