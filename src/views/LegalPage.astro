---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { sourceLang } from '../config/site';
import { getPage } from '../lib/content';
import type { Lang } from '../lib/i18n';
import { url } from '../lib/routes';

interface Props {
  lang: Lang;
  name: 'impressum' | 'datenschutz';
}
const { lang, name } = Astro.props;
const file = name === 'impressum' ? 'imprint' : 'privacy';
const page = await getPage(lang, file);
if (!page) throw new Error(`content/pages/${file}/ is missing`);
const { Content } = await render(page.entry);
const d = page.entry.data;
---

<Base lang={lang} title={d.title} alternates={{ de: url.section('de', name), en: url.section('en', name) }} noindex>
  <main class="legal">
    <h1 class="h1">{d.title}</h1>
    {d.summary && <div class="summary">{d.summary}</div>}
    <div class="body card prose" lang={page.translated ? undefined : sourceLang}>
      <Content />
      {d.updated && <p class="upd">{lang === 'de' ? 'Stand' : 'Last updated'}: {d.updated}</p>}
    </div>
  </main>
</Base>

<style>
  .legal { max-width: 820px; margin: 0 auto; padding: 56px var(--gutter) 88px; display: flex; flex-direction: column; gap: 14px; }
  .legal h1 { margin-bottom: 8px; }
  .summary { background: var(--accent-50); border-radius: 18px; padding: 18px 22px; font-size: 15px; line-height: 1.6; color: #23465a; }
  .body { padding: 30px 34px; font-size: 15.5px; gap: 12px; }
  .body :global(h2) { font-size: 21px; margin-top: 16px; }
  .body :global(h2:first-child) { margin-top: 0; }
  .upd { margin-top: 18px !important; font-size: 13.5px; color: var(--muted); }
  @media (max-width: 720px) {
    .body { padding: 22px 20px; }
  }
</style>
