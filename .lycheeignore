# Links lychee should not check (regular expressions, one per line). Used by .github/workflows/linkcheck.yml.
# Private IPs and localhost are skipped with --exclude-all-private; the patterns below are a second safety net.

# Placeholder and documentation domains (__DOMAIN__ is rendered as example.com)
^https?://([a-z0-9-]+\.)*example\.(com|org|net)
^https?://([a-z0-9-]+\.)*(test|invalid|localhost|local|lan|home\.arpa|internal)([:/]|$)
__[A-Z_]+(\([a-z0-9-]*\))?__
\$\{
# Local addresses and container hostnames from examples
^https?://localhost
^https?://127\.
^https?://192\.168\.
^https?://10\.
^https?://172\.(1[6-9]|2[0-9]|3[01])\.
^https?://[a-z0-9-]+:\d+(/|$)
# Example push/API URLs (Uptime Kuma push, OIDC endpoints …)
/api/push/
/api/oidc/
/api/oauth/
# Our own site (internal links are checked by the build) and pages that need a GitHub login
^https://yourhomelab\.guide
^https://github\.com/yourhomelab-guide/yourhomelab/(edit|new|issues/new)
